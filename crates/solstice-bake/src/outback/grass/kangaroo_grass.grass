# Kangaroo grass (Themeda triandra): open tufts with tall seed stems, turning rust and
# copper as they dry, thin on the ground under the trees.
size 3
tufts per_m2=3.2 blades=14..40 height=0.25..0.8 width=0.004..0.007 lean=0.15..0.7
undergrowth per_m2=45 height=0.04..0.12
variants 0.25,0.25,0.3,0.2
dry 0.6
colors 0.1,0.12,0.04 0.22,0.17,0.07 0.3,0.16,0.07 0.4,0.3,0.14

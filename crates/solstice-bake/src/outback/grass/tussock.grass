# Tussock grass (Poa labillardierei) in summer: dense, fine, arching tussocks knee high, straw
# pale with green at their hearts, and bare ground between.
size 3
tufts per_m2=8 blades=40..120 height=0.22..0.62 width=0.003..0.006 lean=0.25..1.0
undergrowth per_m2=280 height=0.05..0.18
variants 0.3,0.25,0.25,0.2
dry 0.7
# Living blades grey-green; dead ones pale straw to gold.
colors 0.1,0.13,0.05 0.2,0.19,0.08 0.34,0.28,0.13 0.46,0.38,0.2
